{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixieEvent",
  "description": "Event schema for Fixie agent lifecycle and UI streaming",
  "type": "object",
  "required": [
    "run_id",
    "seq",
    "ts",
    "type",
    "data"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the run"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based monotonically increasing sequence number"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "type": {
      "type": "string",
      "enum": [
        "run.started",
        "step.started",
        "step.finished",
        "llm.usage",
        "terminal.chunk",
        "search.result",
        "branch.forked",
        "branch.result",
        "branch.cancelled",
        "branch.winner",
        "deliver.ready",
        "run.finished",
        "run.error"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "run.started"
        },
        "data": {
          "type": "object",
          "required": [
            "issue_title",
            "repo",
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "issue_title": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "live",
                "replay"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.started"
        },
        "data": {
          "type": "object",
          "required": [
            "step",
            "model_tier"
          ],
          "additionalProperties": false,
          "properties": {
            "step": {
              "type": "string",
              "enum": [
                "triage",
                "reproduce",
                "diagnose",
                "branch",
                "deliver"
              ]
            },
            "model_tier": {
              "type": "string",
              "enum": [
                "lightning",
                "super",
                "ultra",
                "none"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "step.finished"
        },
        "data": {
          "type": "object",
          "required": [
            "step",
            "duration_ms",
            "ok"
          ],
          "additionalProperties": false,
          "properties": {
            "step": {
              "type": "string",
              "enum": [
                "triage",
                "reproduce",
                "diagnose",
                "branch",
                "deliver"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "llm.usage"
        },
        "data": {
          "type": "object",
          "required": [
            "model",
            "input_tokens",
            "output_tokens",
            "cost_usd"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "cached": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "terminal.chunk"
        },
        "data": {
          "type": "object",
          "required": [
            "stream",
            "text",
            "branch_id"
          ],
          "additionalProperties": false,
          "properties": {
            "stream": {
              "type": "string",
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "text": {
              "type": "string"
            },
            "branch_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "search.result"
        },
        "data": {
          "type": "object",
          "required": [
            "query",
            "title",
            "url",
            "used"
          ],
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "used": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "branch.forked"
        },
        "data": {
          "type": "object",
          "required": [
            "branches"
          ],
          "additionalProperties": false,
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "strategy"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "strategy": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "branch.result"
        },
        "data": {
          "type": "object",
          "required": [
            "branch_id",
            "tests_passed",
            "diff_lines",
            "sandbox_seconds",
            "score"
          ],
          "additionalProperties": false,
          "properties": {
            "branch_id": {
              "type": "string"
            },
            "tests_passed": {
              "type": "boolean"
            },
            "diff_lines": {
              "type": "integer",
              "minimum": 0
            },
            "sandbox_seconds": {
              "type": "number",
              "minimum": 0
            },
            "score": {
              "type": "number"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "branch.winner"
        },
        "data": {
          "type": "object",
          "required": [
            "branch_id"
          ],
          "additionalProperties": false,
          "properties": {
            "branch_id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "deliver.ready"
        },
        "data": {
          "type": "object",
          "required": [
            "diff",
            "root_cause",
            "pr_url"
          ],
          "additionalProperties": false,
          "properties": {
            "diff": {
              "type": "string"
            },
            "root_cause": {
              "type": "string"
            },
            "pr_url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.finished"
        },
        "data": {
          "type": "object",
          "required": [
            "status",
            "total_cost_usd",
            "total_seconds"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failed"
              ]
            },
            "total_cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "total_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.error"
        },
        "data": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "branch.cancelled"
        },
        "data": {
          "type": "object",
          "required": [
            "branch_id"
          ],
          "additionalProperties": false,
          "properties": {
            "branch_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
